{
  "expo": {
    "name": "Hobbie",
    "slug": "hobbie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo/icon-light.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0D0B14",
    "primaryColor": "#7B2FF7",
    "owner": "akshat779s-team",
    "splash": {
      "image": "./assets/logo/splash-light.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D0B14",
      "dark": {
        "image": "./assets/logo/splash-light.png",
        "resizeMode": "contain",
        "backgroundColor": "#0D0B14"
      }
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hobbie.app",
      "backgroundColor": "#0D0B14",
      "userInterfaceStyle": "dark",
      "splash": {
        "image": "./assets/logo/splash-light.png",
        "resizeMode": "contain",
        "backgroundColor": "#0D0B14",
        "dark": {
          "image": "./assets/logo/splash-light.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D0B14"
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo/icon-light.png",
        "backgroundColor": "#0D0B14"
      },
      "backgroundColor": "#0D0B14",
      "userInterfaceStyle": "dark",
      "package": "com.hobbie.app",
      "splash": {
        "image": "./assets/logo/splash-light.png",
        "resizeMode": "contain",
        "backgroundColor": "#0D0B14",
        "dark": {
          "image": "./assets/logo/splash-light.png",
          "resizeMode": "contain",
          "backgroundColor": "#0D0B14"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "splash": {
        "image": "./assets/logo/splash-light.png",
        "resizeMode": "contain",
        "backgroundColor": "#0D0B14"
      }
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "scheme": "hobbie",
    "extra": {
      "eas": {
        "projectId": "9d46f924-fefc-40a2-9183-75b633760b85"
      }
    }
  }
}
